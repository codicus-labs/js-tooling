{
    "name": "js-tooling",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vp run -r build",
        "check": "vp check && knip",
        "prepare": "vp config && vp run build"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@commitlint/config-conventional": "21.2.2",
        "@types/node": "26.1.0",
        "knip": "6.37.0",
        "typescript": "6.0.3",
        "vite-plus": "catalog:"
    },
    "commitlint": {
        "extends": [
            "@commitlint/config-conventional"
        ]
    },
    "engines": {
        "node": ">=24"
    },
    "packageManager": "pnpm@12.14.0",
    "knip": {
        "ignore": [
            "packages/pnpm-plugin/pnpmfile.mjs",
            "packages/create/templates/**"
        ],
        "ignoreDependencies": [
            "@commitlint/cli"
        ],
        "workspaces": {
            ".": {},
            "packages/configs": {
                "entry": [
                    "src/{vite-plus,lint,fmt,eslint}.ts",
                    "src/lint-rules/index.ts"
                ]
            }
        }
    }
}
