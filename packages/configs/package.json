{
    "name": "@codicus/configs",
    "version": "0.9.0",
    "description": "Shared Vite+, ESLint, and TypeScript configurations",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codicus-labs/js-tooling.git",
        "directory": "packages/configs"
    },
    "files": [
        "dist",
        "tsconfig"
    ],
    "type": "module",
    "exports": {
        "./vite-plus": {
            "types": "./dist/vite-plus.d.mts",
            "default": "./dist/vite-plus.mjs"
        },
        "./lint": {
            "types": "./dist/lint.d.mts",
            "default": "./dist/lint.mjs"
        },
        "./fmt": {
            "types": "./dist/fmt.d.mts",
            "default": "./dist/fmt.mjs"
        },
        "./eslint": {
            "types": "./dist/eslint.d.mts",
            "default": "./dist/eslint.mjs"
        },
        "./lint-rules": {
            "types": "./dist/lint-rules/index.d.mts",
            "default": "./dist/lint-rules/index.mjs"
        },
        "./tsconfig/base.json": "./tsconfig/base.json",
        "./tsconfig/node.json": "./tsconfig/node.json"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "vp pack"
    },
    "dependencies": {
        "@tsconfig/node24": "24.0.5"
    },
    "devDependencies": {
        "eslint": "10.9.0",
        "typescript": "6.0.3",
        "vite-plus": "catalog:"
    },
    "peerDependencies": {
        "@types/node": ">=24 <27",
        "eslint": ">=10 <11",
        "typescript": ">=5.9 <8",
        "vite-plus": ">=1.3 <2"
    },
    "peerDependenciesMeta": {
        "@types/node": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "typescript": {
            "optional": true
        },
        "vite-plus": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=24"
    }
}
