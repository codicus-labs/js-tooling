{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"],
        "isolatedDeclarations": true,
        "declaration": true,
        "rootDir": "../src",
        "outDir": "../dist",
        "tsBuildInfoFile": "../node_modules/.cache/tsconfig.app.tsbuildinfo"
    },
    "include": ["../src/**/*.ts"],
    "exclude": ["../src/**/*.spec.ts"]
}
